<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<div class="container mt-5">

    <div class="card p-4 shadow">

        <h3 class="mb-4">Личный кабинет</h3>

        <!-- Аватар -->
        <% if (avatar) { %>
            <img src="<%= avatar %>" width="100" class="mb-3 rounded">
        <% } %>

        <hr>

        <h5>Статистика теста</h5>

        <p>Попыток: <b><%= stats.attempts %></b></p>

        <% if (stats.best) { %>
            <p>
                Лучший результат: 
                <b><%= stats.best.score %>/<%= stats.best.total %></b>
            </p>

            <p>
                Время: <b><%= stats.best.time_seconds %> сек</b>
            </p>
        <% } else { %>
            <p>Вы ещё не проходили тест</p>
        <% } %>

        <hr>

        <form onsubmit="event.preventDefault(); handleForm(this, '/profile')">

            <h5>ФИО</h5>

            <input name="last_name" class="form-control mb-2" placeholder="Фамилия" value="<%= user.last_name || '' %>">
            <input name="first_name" class="form-control mb-2" placeholder="Имя" value="<%= user.first_name || '' %>">
            <input name="middle_name" class="form-control mb-3" placeholder="Отчество" value="<%= user.middle_name || '' %>">

            <h5>Email</h5>

            <input name="email" type="email" class="form-control mb-3" value="<%= user.email || '' %>">

            <h5>Смена пароля</h5>

            <input name="password" type="password" class="form-control mb-2" placeholder="Новый пароль">
            <input name="password2" type="password" class="form-control mb-3" placeholder="Повторите пароль">

            <div class="d-flex gap-2">
                <button class="btn btn-success">Сохранить</button>
                <a href="/" class="btn btn-secondary">Назад</a>
            </div>

        </form>

    </div>

</div>