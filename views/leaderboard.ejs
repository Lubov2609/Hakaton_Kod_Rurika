<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<div class="container mt-5">
    <div class="card shadow p-4">

        <h3 class="mb-4">🏆 Топ игроков</h3>

        <table class="table table-striped">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Никнейм</th>
                    <th>Рейтинг</th>
                    <th>Лучший результат</th>
                    <th>Время</th>
                    <th>Попытки</th>
                </tr>
            </thead>
            <tbody>
                <% users.forEach((user, index) => { %>
                    <tr>
                        <td><%= (currentPage - 1) * 5 + index + 1 %></td>
                        <td><%= user.username %></td>

                        <td>
                            <% if (index === 0 && currentPage === 1) { %> 1 🥇
                            <% } else if (index === 1 && currentPage === 1) { %> 2 🥈
                            <% } else if (index === 2 && currentPage === 1) { %> 3 🥉
                            <% } else { %>
                                —
                            <% } %>
                        </td>

                        <td>
                            <% if (user.best_score) { %>
                                <%= user.best_score %> / 12
                            <% } else { %>
                                —
                            <% } %>
                        </td>
                        <td>
                            <% if (user.best_time) { %>
                                <%= user.best_time %> сек
                            <% } else { %>
                                —
                            <% } %>
                        </td>

                        <td><%= user.attempts || 0 %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>

        <nav>
            <ul class="pagination">
                <% if (currentPage > 1) { %>
                    <li class="page-item">
                        <a class="page-link" href="/leaderboard?page=<%= currentPage - 1 %>">Назад</a>
                    </li>
                <% } %>

                <li class="page-item disabled">
                    <span class="page-link">
                        <%= currentPage %> / <%= totalPages %>
                    </span>
                </li>

                <% if (currentPage < totalPages) { %>
                    <li class="page-item">
                        <a class="page-link" href="/leaderboard?page=<%= currentPage + 1 %>">Вперёд</a>
                    </li>
                <% } %>
            </ul>
        </nav>

        <a href="/" class="btn btn-secondary">Назад</a>

    </div>
</div>