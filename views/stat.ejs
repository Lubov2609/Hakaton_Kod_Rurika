<div class="container mt-5">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <div class="card shadow p-4">

        <h3 class="mb-4">Список пользователей</h3>

        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Никнейм</th>
                    <th>Рейтинг среди игроков</th>
                    <th>Финальный тест</th>
                    <th>Кол-во попыток</th>
                </tr>
            </thead>
            <tbody>
                <% users.forEach(user => { %>
                    <tr>
                        <td><%= user.id %></td>
                        <td><%= user.username %></td>
                        <td>1</td>
                        <td>99/100</td>
                        <td>5</td>
                    </tr>
                <% }) %>
            </tbody>
        </table>

        <nav>
            <ul class="pagination">
                <% if (currentPage > 1) { %>
                    <li class="page-item">
                        <a class="page-link" href="/stat?page=<%= currentPage - 1 %>">Назад</a>
                    </li>
                <% } %>

                <li class="page-item disabled">
                    <span class="page-link">
                        <%= currentPage %> / <%= totalPages %>
                    </span>
                </li>

                <% if (currentPage < totalPages) { %>
                    <li class="page-item">
                        <a class="page-link" href="/stat?page=<%= currentPage + 1 %>">Вперёд</a>
                    </li>
                <% } %>
            </ul>
        </nav>

        <a href="/" class="btn btn-secondary">Назад</a>

    </div>

</div>