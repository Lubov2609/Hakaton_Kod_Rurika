<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="/css/auth.css" rel="stylesheet">

<div class="game-screen" style="display:block;">

    <!-- ФОН -->
    <img src="/assets/login.png" class="bg">

    <!-- ЛОГО (кораблик + текст) -->
    <div class="login-logo">
        <img src="/assets/logo_menu.png" class="logo-ship">
        <div class="logo-text">КОД РЮРИКА</div>
    </div>

    <!-- ФОРМА -->
    <div class="auth-box">

        <% if (error) { %>
            <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <h2>Создать аккаунт</h2>

        <form onsubmit="event.preventDefault(); handleForm(this, '/register')">
            <label>Никнейм</label>
            <input 
                type="text" 
                name="username" 
                class="form-control"
                placeholder="Будет вашим логином в игре"
                value="<%= username %>"
                required
            >
            <label>Пароль</label>
            <div class="password-field">
                <input
                id="confirm"
                type="password" 
                name="password" 
                class="form-control"
                placeholder="Пароль"
                required
                >
                <span class="eye" onclick="togglePassword('confirm')"></span>
            </div>
            <p class="register">
                Уже есть аккаунт?
                <a href="/login">Войти</a>
            </p>
            <button class="login-btn">ЗАРЕГИСТРИРОВАТЬСЯ</button>
        </form>

    </div>
</div>

<script>
// показать / скрыть пароль
function togglePassword(id) {
    const input = document.getElementById(id);
    input.type = input.type === "password" ? "text" : "password";
}
</script>