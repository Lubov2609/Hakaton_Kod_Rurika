<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title><%= typeof title !== 'undefined' ? title : 'App' %></title>

    <!-- <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"> -->
    <!-- <link href="/css/main.css" rel="stylesheet"> -->
    <link href="/css/style.css" rel="stylesheet">
</head>

<body class="bg-light">

    <!-- Иконка логина -->
    <!-- <div class="position-fixed top-0 end-0 p-3">
        <% if (user) { %>
            <span class="me-2">👤 <a href="/profile"><%= user.username %></a></span>
            <button onclick="logout()" class="btn btn-outline-danger btn-sm">Выйти</button>
        <% } else { %>
            <a href="/login" class="btn btn-outline-dark btn-sm">🔐 Вход</a>
        <% } %>
    </div> -->

    <!-- Toast -->
    <% if (flash) { %>
    <div class="toast-container position-fixed top-0 end-0 p-3">
        <div class="toast align-items-center text-white bg-<%= flash.type === 'success' ? 'success' : (flash.type === 'info' ? 'primary' : 'danger') %> border-0 show">
            <div class="d-flex">
                <div class="toast-body">
                    <%= flash.message %>
                </div>
            </div>
        </div>
    </div>
    <% } %>

    <!-- Контент страницы -->
    <%- body %>

    <script src="/js/main.js"></script>
</body>
</html>